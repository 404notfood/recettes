APP_NAME="Cuistot Club"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://recettes.cuistot-club.fr
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Le générateur remplit les identifiants PostgreSQL sur le VPS.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cuistot_recettes
DB_USERNAME=cuistot_recettes
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=cuistot_recettes_

# Rendu Inertia : service systemd fourni dans deploy/.
INERTIA_SSR_ENABLED=true
RECIPE_EDITOR_EMAIL=redaction@recettes.cuistot-club.fr

# Configurer un vrai SMTP avant l'ouverture des inscriptions.
# log conserve les courriels localement et ne les envoie pas.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
